# info-feed 配置 —— 拷贝为 config.env 后按需改(config.env 不入库)
# 源列表: 逗号分隔, 每条 "名称|RSS/Atom URL"(config 按行解析, 必须写成一行)
FEEDS="HN|https://hnrss.org/frontpage, V2EX|https://www.v2ex.com/index.xml, GitHub Blog|https://github.blog/feed/"
# 本服务监听端口
PORT=8791
# 每个源的缓存时长(毫秒), 默认 10 分钟; 源站有频率限制时调大
CACHE_TTL_MS=600000
# 时间线默认最多返回条数
MAX_ITEMS=200
